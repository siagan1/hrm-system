// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

enum Role {
  ADMIN
  MANAGER
  USER
}

// ── 기준 정보 ─────────────────────────────

// 워킹데이(근무일수)에서 제외할 특정 날짜. 주말은 항상 제외된 것으로 간주하며,
// 여기 등록된 평일만 추가로 제외됩니다. 월별 총일수/근무일수/휴일수는
// 이 테이블 + 달력을 기준으로 그때그때 계산합니다 (src/lib/working-days.ts).
model NonWorkingDay {
  id        String   @id @default(cuid())
  date      DateTime @unique
  reason    String?
  createdAt DateTime @default(now())

  @@index([date])
}

model GradeCriterion {
  id             String  @id @default(cuid())
  gradeName      String  @unique
  requiredMonths Int
  description    String?
}

enum GradeOptionCategory {
  EDUCATION
  CERTIFICATE
}

// 등급 산정용 학력/자격증 인정개월수 옵션. 관리자가 "등급 옵션 관리" 화면에서
// months 값만 편집하며(항목 자체는 고정 목록), 직원 기본정보에서 이 중 하나를
// 선택하면 EmployeeGrade.eduMonths/certMonths가 자동 계산됩니다.
// 학력/자격증 모두 "보유한 것 중 가장 높은 것 1개만 인정"하는 단일 선택입니다.
model GradeOption {
  id        String              @id @default(cuid())
  category  GradeOptionCategory
  label     String
  months    Int                 @default(0)
  sortOrder Int                 @default(0)

  eduSelections  EmployeeGrade[] @relation("EduOption")
  certSelections EmployeeGrade[] @relation("CertOption")

  @@unique([category, label])
}

// ── 계정 / 인력 ─────────────────────────────

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  role         Role     @default(USER)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  employee          Employee?
  dashboardSettings DashboardSetting[]
}

model Employee {
  id              String    @id @default(cuid())
  userId          String?   @unique // 로그인 계정이 없는 직원도 존재할 수 있음 (HRM은 팀장/대표만 로그인)
  user            User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  name            String
  email           String?   @unique // 회사 이메일. 로그인 계정 생성 시 기본 아이디로 사용
  empType         String // 예: REGULAR, CONTRACT, DISPATCH 등 (추후 enum 전환 가능)
  joinDate        DateTime
  resignDate      DateTime?
  contractEndDate DateTime?
  // 계약 만료(contractEndDate) 이후에도 "계약 연장/전환을 전제로" 연간 계획(가동률 계획 모드)에서
  // 이 날짜까지는 가용 인력으로 계산합니다. contractEndDate는 HR 알림용으로 그대로 유지되며,
  // 이 필드는 오직 계획 모드 계산(getPlanningEffectiveResignDate)에서만 쓰입니다.
  plannedActiveUntil DateTime?
  regularConversionDate DateTime? // 계약직 -> 정규직 전환 예정일. 이 날짜가 지나면 구분이 자동으로 정규직으로 바뀝니다.
  // 대표/사업전략팀장처럼 실무를 하지 않아 원래 가동률 집계 대상이 아닌 인원 표시.
  // 기본값(false)은 "가동률 집계 대상"이며, 예외적인 기간은 utilizationOverrides로 뒤집습니다.
  excludedFromUtilization Boolean @default(false)
  // CEO 등 조직도 밖에서 관리하는 임원. true로 켜면 가동률 집계 제외(excludedFromUtilization)가
  // 같이 설정되고, 등급 분포/등급 상승 알림 등 등급 관련 집계에서도 제외됩니다(소속 팀도 선택사항).
  isExecutive     Boolean   @default(false)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  teamHistories EmployeeTeamHistory[]
  grade         EmployeeGrade?
  lpRecords     LpRecord[]
  allocations   ProjectAllocation[]
  utilizationOverrides EmployeeUtilizationOverride[]
  projectAssignments ProjectAssignment[]
  certifications EmployeeCertification[]
}

// 직원이 보유한 자격증 목록입니다(등급 산정용 EmployeeGrade.certOptionId와는 별개 —
// 그쪽은 등급 환산에 쓰는 "최고 등급 1개"만 선택하고, 여기는 보유한 자격증을 전부 기록합니다).
model EmployeeCertification {
  id           String   @id @default(cuid())
  employeeId   String
  employee     Employee @relation(fields: [employeeId], references: [id])
  name         String
  acquiredDate DateTime
  createdAt    DateTime @default(now())

  @@index([employeeId])
}

enum UtilizationOverrideMode {
  INCLUDE
  EXCLUDE
}

// excludedFromUtilization(기본 상태)을 특정 기간만 뒤집는 예외 규정.
// 예: 평소 가동률 제외 대상인 팀장이 인력 부족 시 일시적으로 투입되는 기간 -> INCLUDE.
//     평소 가동률 대상인 직원이 휴직하는 기간 -> EXCLUDE.
// startDate/endDate 둘 다 null이면 무기한(처음부터 계속) 적용됩니다.
model EmployeeUtilizationOverride {
  id         String                  @id @default(cuid())
  employeeId String
  employee   Employee                @relation(fields: [employeeId], references: [id])
  mode       UtilizationOverrideMode
  startDate  DateTime?
  endDate    DateTime?
  reason     String?
  createdAt  DateTime                @default(now())

  @@index([employeeId])
}

// ── 조직 / 이력(SCD Type 2) ───────────────────
// Group/Team은 조직개편(효력일 기준)마다 "바뀐 것만" 새 row로 버저닝됩니다.
// 이름/소속이 바뀌지 않은 팀은 reorg가 일어나도 같은 id를 유지합니다 — 그래야
// EmployeeTeamHistory.teamId가 안 바뀐 팀에 대해서는 흔들리지 않습니다.
// 바뀐(개명/이동/소속그룹 개명) 경우에는 기존 row를 닫고 previousTeamId/
// previousGroupId로 연결된 새 row를 열며, org.actions.ts의 applyDueOrgSuccessions()가
// 효력일이 지나는 시점에 맞물린 EmployeeTeamHistory를 새 row로 자동 이관합니다.

model Group {
  id          String  @id @default(cuid())
  groupName   String
  description String?
  startDate   DateTime? // null = 처음부터(초기 백필)
  endDate     DateTime? // null = 현재 유효

  previousGroupId String? @unique
  previousGroup   Group?  @relation("GroupSuccession", fields: [previousGroupId], references: [id])
  nextGroup       Group?  @relation("GroupSuccession")

  teams Team[]

  @@index([startDate])
  @@index([endDate])
}

model Team {
  id          String  @id @default(cuid())
  teamName    String // @unique 아님 — 폐지된 팀명이 나중에 재사용될 수 있음(현재 살아있는 row만 유일해야 함, submitReorg에서 검증)
  description String?
  startDate   DateTime? // null = 처음부터(초기 백필)
  endDate     DateTime? // null = 현재 유효

  groupId String?
  group   Group?  @relation(fields: [groupId], references: [id])

  previousTeamId String? @unique
  previousTeam   Team?   @relation("TeamSuccession", fields: [previousTeamId], references: [id])
  nextTeam       Team?   @relation("TeamSuccession")

  employeeHistories EmployeeTeamHistory[]

  @@index([groupId])
  @@index([startDate])
  @@index([endDate])
}

model EmployeeTeamHistory {
  id         String    @id @default(cuid())
  employeeId String
  employee   Employee  @relation(fields: [employeeId], references: [id])
  teamId     String
  team       Team      @relation(fields: [teamId], references: [id])
  startDate  DateTime
  endDate    DateTime? // null = 현재 소속

  @@index([employeeId])
  @@index([teamId])
}

// ── 등급 / LP(성과개선) ───────────────────────

model EmployeeGrade {
  id           String       @id @default(cuid())
  employeeId   String       @unique
  employee     Employee     @relation(fields: [employeeId], references: [id])
  eduOptionId  String?
  eduOption    GradeOption? @relation("EduOption", fields: [eduOptionId], references: [id])
  certOptionId String?
  certOption   GradeOption? @relation("CertOption", fields: [certOptionId], references: [id])
  eduMonths    Int          @default(0)
  certMonths   Int          @default(0)
  expMonths    Int          @default(0)
  totalMonths  Int          @default(0)
  currentGrade String
  updatedAt    DateTime     @updatedAt
}

model LpRecord {
  id           String   @id @default(cuid())
  employeeId   String
  employee     Employee @relation(fields: [employeeId], references: [id])
  reason       String
  actionPlan   String
  registeredBy String
  createdAt    DateTime @default(now())

  @@index([employeeId])
}

// ── 프로젝트 / 투입(가동률) ────────────────────

model Project {
  id              String    @id @default(cuid())
  projectCode     String?   @unique
  name            String
  clientName      String
  location        String?
  startDate       DateTime
  endDate         DateTime?
  totalContractMm Float?

  // 상위(마스터) 프로젝트 — 예: "26년 알티미디어 용역 검증" 계약 하나에 여러 하위 프로젝트를 등록해 관리
  parentProjectId String?
  parentProject   Project?  @relation("ProjectHierarchy", fields: [parentProjectId], references: [id])
  subProjects     Project[] @relation("ProjectHierarchy")

  allocations ProjectAllocation[]
  assignments ProjectAssignment[]

  @@index([parentProjectId])
}

model ProjectAllocation {
  id          String   @id @default(cuid())
  employeeId  String
  employee    Employee @relation(fields: [employeeId], references: [id])
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id])
  targetMonth String // "YYYY-MM"
  inputMm     Float
  isManualMm  Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@unique([employeeId, projectId, targetMonth])
  @@index([projectId])
}

// 직원×프로젝트 배정 "기간"을 한 번만 등록하면, 그 기간에 해당하는 달의
// ProjectAllocation을 자동으로 채워줍니다(isManualMm=false로). 이미 사람이
// 직접 고친 달(isManualMm=true)은 생성/재생성/삭제 어느 경우에도 건드리지 않습니다.
// 배정 1건은 여러 개의 기간(구간, ProjectAssignmentPeriod)을 가질 수 있습니다 —
// 같은 프로젝트를 하다가 잠깐 빠졌다가 다시 투입되는 경우를 배정 하나로 등록하기 위함.
// employeeId가 null이면 아직 채용되지 않은 "가상 인력(Placeholder)" 배정입니다 —
// placeholderLabel/placeholderGrade로 설명하며, 이 경우 ProjectAllocation은 절대
// 생성하지 않고(실제 투입 데이터는 순수하게 유지) 가동률 "계획" 모드 조회 시점에만
// 계산에 포함됩니다.
model ProjectAssignment {
  id               String    @id @default(cuid())
  employeeId       String?
  employee         Employee? @relation(fields: [employeeId], references: [id])
  placeholderLabel String?
  placeholderGrade String?
  projectId        String
  project          Project   @relation(fields: [projectId], references: [id])
  monthlyMm        Float     @default(1) // 매달 투입 비율(기본 1.0 = 풀타임), 구간 전체에 공통 적용
  createdAt        DateTime  @default(now())

  periods ProjectAssignmentPeriod[]

  @@index([employeeId])
  @@index([projectId])
}

// ProjectAssignment 1건에 속한 개별 기간(구간). endDate가 null이면 그 구간은 진행중이며,
// project-assignment.actions.ts의 applyDueAssignmentAllocations()가 읽기 시점마다
// 이번 달 몫을 지연 생성합니다. 한 배정 안의 구간들은 서로 겹치지 않아야 합니다
// (생성/수정 시 서버 액션에서 검증).
model ProjectAssignmentPeriod {
  id           String            @id @default(cuid())
  assignmentId String
  assignment   ProjectAssignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  startDate    DateTime
  endDate      DateTime? // null = 진행중

  @@index([assignmentId])
}

// ── 대시보드 설정 ───────────────────────────

model DashboardSetting {
  id         String   @id @default(cuid())
  userId     String   @unique
  user       User     @relation(fields: [userId], references: [id])
  layoutData Json
  updatedAt  DateTime @updatedAt
}

// ── 알림 ───────────────────────────────────

// 알림 생성 기준(싱글턴 1행). DashboardSetting과 달리 사용자별이 아니라 전사 공통입니다.
model NotificationSetting {
  id                          String   @id @default(cuid())
  regularConversionLeadMonths Int      @default(1)
  contractExtensionLeadMonths Int      @default(1)
  gradeUpgradeLeadMonths      Int      @default(1)
  updatedAt                   DateTime @updatedAt
}

// 연도별 가동률 목표치. 연도마다 따로 설정해 누적 관리합니다.
model UtilizationYearlyTarget {
  id         String   @id @default(cuid())
  year       String   @unique
  targetRate Float
  updatedAt  DateTime @updatedAt
}

enum NotificationType {
  UTILIZATION_BELOW_TARGET
  REGULAR_CONVERSION
  CONTRACT_EXTENSION
  GRADE_UPGRADE
}

// 알림함에 실제로 쌓이는 항목. targetKey로 같은 사건에 대한 중복 생성을 막습니다
// (예: "util-2026-09", "regconv-<employeeId>-2026-10").
model Notification {
  id         String           @id @default(cuid())
  type       NotificationType
  title      String
  message    String
  link       String?
  targetKey  String
  occurredOn DateTime
  readAt     DateTime?
  createdAt  DateTime         @default(now())

  @@unique([type, targetKey])
  @@index([readAt])
}

// 주간보고용 공유 메모. 1개 행만 유지하며 매주 덮어씁니다.
model WeeklyNote {
  id        String   @id @default(cuid())
  content   String
  updatedAt DateTime @updatedAt
}
